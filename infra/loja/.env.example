# Servidor da loja (ComandAdA rodando sem depender da internet)
# Copie para infra/loja/.env:  make loja-setup

# Nome que aparece nos backups e nos containers
COMPOSE_PROJECT_NAME=comandada-loja

# Banco local (troque as senhas)
POSTGRES_USER=comandada
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=comandada

# Segredos da API (gere com: openssl rand -hex 32)
JWT_SECRET=troque-por-um-segredo-de-32-caracteres-ou-mais
JWT_REFRESH_SECRET=troque-por-outro-segredo-de-32-caracteres
APP_SECRET=troque-por-um-terceiro-segredo-de-32-caracteres
N8N_INTERNAL_API_TOKEN=troque-este-token-interno

# Porta em que o painel fica na rede local (80 = http://comandada.local sem porta)
LOJA_HTTP_PORT=80

# Impressora térmica da cozinha/caixa: tcp://IP:9100 para impressora de rede
FISCAL_PRINTER_INTERFACE=tcp://192.168.0.50:9100

# Sincronização com a nuvem. A loja trabalha offline e envia tudo em partes quando a internet volta.
# SYNC_PEER_URL: endereço da API na nuvem. SYNC_TOKEN: o mesmo valor configurado na nuvem (32+ caracteres).
# Deixe SYNC_ROLE vazio para rodar só local, sem nuvem.
SYNC_ROLE=loja
SYNC_NODE_NAME=yuyaki
SYNC_PEER_URL=https://api.seu-dominio.com.br
SYNC_TOKEN=troque-pelo-token-de-sincronizacao-da-nuvem
# Intervalo entre ciclos, tempo limite de cada envio e tamanho máximo do lote
SYNC_INTERVAL_MS=5000
SYNC_REQUEST_TIMEOUT_MS=15000
SYNC_BATCH_SIZE=200

# Workers locais (estoque e fiscal rodam na loja)
STOCK_WORKER_ENABLED=true
FISCAL_WORKER_ENABLED=true
FINANCE_WORKER_ENABLED=true
PRODUCT_AFFINITY_WORKER_ENABLED=false

# Backup do banco: de quantas em quantas horas, e quantos arquivos manter
BACKUP_INTERVAL_HOURS=1
BACKUP_KEEP=72

# WhatsApp (opcional na loja; o bot roda na nuvem). Deixe vazio se não usar.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
